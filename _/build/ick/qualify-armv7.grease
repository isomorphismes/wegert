#!/usr/bin/env grease
set -eu -o pipefail
if (len(ARGV) < 6) {
  echo 'usage: qualify-armv7.grease ICK_CHECKOUT COMPILER_ZIP NDK SDK NEW_OUTPUT GREASE [GREASE_ARGS...]'
  exit 2
}
var ick_source = ARGV[0]
var archive = ARGV[1]
var ndk = ARGV[2]
var sdk = ARGV[3]
setvar ick_source = $(readlink -f "$ick_source")
setvar archive = $(readlink -f "$archive")
setvar ndk = $(readlink -f "$ndk")
setvar sdk = $(readlink -f "$sdk")
var output = ARGV[4]
var runtime = ARGV[5:]
var script_dir = $(dirname "$(readlink -f "$0")")
var repo = $(git -C "$script_dir" rev-parse --show-toplevel)
var source_revision = $(git -C "$repo" rev-parse HEAD)
var qualifier = "$ick_source/qualification/android-boundary/compile-application.grease"
var compiler_revision = '515c0f29fe6e2e96e10495fbaf25da93532e7722'
var archive_digest = 'd3d60223712a8f5119451e15344f9a22ace0824eca19f2e78792b0dc18ab509c'
test -f "$qualifier"
test -f "$archive"
test -d "$ndk"
test -d "$sdk"
test ! -e "$output"
if (len(output) === 0 or output[0] !== '/') {
  echo 'output must be an absolute path'
  exit 2
}
test "$(sha256sum "$archive" | awk '{print $1}')" = "$archive_digest"
mkdir -p "$output/compiler" "$output/objects" "$output/reference" "$output/package/lib/armeabi-v7a" "$output/assets"
unzip -q "$archive" -d "$output/compiler"
var compiler = "$output/compiler/xgcc"
var cc1 = "$output/compiler/cc1"
test "$(sha256sum "$compiler" | awk '{print $1}')" = 'c78697d096ffe8ba10fbcc3bae9b35d0c934bee11a3626813656ac84e126f9ad'
test "$(sha256sum "$cc1" | awk '{print $1}')" = '289dee590a515e6426a6ab74d7dc8c143e428836a3a79036a75444f0622fba73'
chmod 755 "$compiler" "$cc1" "$output/compiler/collect2"
test "$("$compiler" "-B$output/compiler/" -print-prog-name=cc1)" = "$cc1"
var llvm = "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
var reference = "$llvm/armv7a-linux-androideabi26-clang"
var glue_dir = "$ndk/sources/android/native_app_glue"
var flags = ['-I' ++ repo ++ '/code', '-I' ++ glue_dir, '-DBIONIC_IOCTL_NO_SIGNEDNESS_OVERLOAD', '-Wall', '-Wextra']
var names = ['wegert', 'wegert_function', 'wegert_view', 'wegert_scene', 'wegert_gles', 'wegert_portrait_renderer_gles', 'wegert_placement_controls', 'wegert_overlay_renderer_gles', 'complex_math_ick', 'android_native_app_glue']
var objects = []
var reference_objects = []
printf 'wegert_source\t%s\ncompiler_source\t%s\ncompiler_archive_sha256\t%s\nabi\tarmeabi-v7a/A32/softfp\ncompile_owner\tICK\nlink_owner\tNDK-r29\nphysical_execution\tNOT_RUN\noutput_equivalence\tNOT_RUN\nfdroid\tNOT_RUN\n' "$source_revision" "$compiler_revision" "$archive_digest" > "$output/receipt.tsv"
for name in (names) {
  var source = "$repo/code/$name.c"
  if (name === 'android_native_app_glue') {
    setvar source = "$glue_dir/android_native_app_glue.c"
  }
  var object = "$output/objects/$name.o"
  var reference_object = "$output/reference/$name.o"
  @runtime "$qualifier" "$compiler" "$ndk" 26 "$source" "$object" "-B$output/compiler/" @flags
  "$reference" -std=c17 -O2 -fPIC -marm -march=armv7-a -mfloat-abi=softfp -mfpu=vfpv3-d16 @flags -c "$source" -o "$reference_object" > "$reference_object.log" 2>&1
  setvar objects = objects ++ [object]
  setvar reference_objects = reference_objects ++ [reference_object]
  sha256sum "$source" "$object" "$reference_object" >> "$output/source-and-object.sha256"
}
var link_flags = ['-shared', '-Wl,-z,defs', '-Wl,-z,text', '-Wl,--fatal-warnings', '-Wl,-soname,libwegert.so', '-Wl,-u,ANativeActivity_onCreate']
"$reference" @link_flags @objects -landroid -llog -lEGL -lGLESv3 -lm -o "$output/libwegert.so"
"$reference" @link_flags @reference_objects -landroid -llog -lEGL -lGLESv3 -lm -o "$output/reference/libwegert.so"
"$llvm/llvm-readobj" --elf-output-style=GNU -h -l -d "$output/libwegert.so" > "$output/android-elf.txt"
"$llvm/llvm-nm" -D --defined-only "$output/libwegert.so" | awk '{print $3}' | sort -u > "$output/ick.exports"
"$llvm/llvm-nm" -D --defined-only "$output/reference/libwegert.so" | awk '{print $3}' | sort -u > "$output/reference.exports"
diff -u "$output/reference.exports" "$output/ick.exports"
rg -qx 'ANativeActivity_onCreate' "$output/ick.exports"
rg -qx 'wegert_expand_roots_cartesian' "$output/ick.exports"
cp "$output/libwegert.so" "$output/package/lib/armeabi-v7a/libwegert.so"
var marker = '/*__WEGERT_COLOR_CORE__*/'
test "$(rg -c -F "$marker" "$repo/code/wegert.frag.in")" = 1
var color_insert = r'/\/\*__WEGERT_COLOR_CORE__\*\//r ' ++ repo ++ '/code/wegert_color.glsl'
sed -e "$color_insert" -e '/\/\*__WEGERT_COLOR_CORE__\*\//d' "$repo/code/wegert.frag.in" > "$output/assets/wegert.frag"
sed -e 's/<manifest xmlns:android="http:\/\/schemas.android.com\/apk\/res\/android">/<manifest xmlns:android="http:\/\/schemas.android.com\/apk\/res\/android" package="org.isomorphisms.wegert">/' -e 's/${appLabel}/zero \&amp; infinity/' "$repo/_/build/app/src/main/AndroidManifest.xml" > "$output/AndroidManifest.xml"
var properties = "$repo/_/build/fdroid/release.properties"
var version_code = $(sed -n 's/^versionCode=//p' "$properties")
var version_name = $(sed -n 's/^versionName=//p' "$properties")
var tools = "$sdk/build-tools/36.0.0"
"$tools/aapt2" compile --dir "$repo/_/build/app/src/main/res" -o "$output/resources.zip"
"$tools/aapt2" link -I "$sdk/platforms/android-36/android.jar" --manifest "$output/AndroidManifest.xml" --min-sdk-version 26 --target-sdk-version 36 --version-code "$version_code" --version-name "$version_name" -A "$output/assets" -o "$output/unaligned.apk" "$output/resources.zip"
pushd "$output/package"
zip -q -X -0 "$output/unaligned.apk" lib/armeabi-v7a/libwegert.so
popd
"$tools/zipalign" -P 16 -f 4 "$output/unaligned.apk" "$output/aligned.apk"
"$tools/apksigner" sign --ks "$repo/_/build/app/wegert-debug.keystore" --ks-type PKCS12 --ks-pass pass:wegert-debug --key-pass pass:wegert-debug --ks-key-alias wegert-debug --out "$output/wegert-ick-armeabi-v7a.apk" "$output/aligned.apk"
"$tools/apksigner" verify --verbose --print-certs "$output/wegert-ick-armeabi-v7a.apk" > "$output/signing.txt"
rg -q 'certificate SHA-256 digest: de9b1d47c5a65e6d46a204b79dd9ee566b9d3c9832ba81ebc4213d3392e92ff9' "$output/signing.txt"
"$tools/zipalign" -c -P 16 4 "$output/wegert-ick-armeabi-v7a.apk"
unzip -t "$output/wegert-ick-armeabi-v7a.apk" > "$output/apk-integrity.txt"
sha256sum "$compiler" "$cc1" "$output/libwegert.so" "$output/reference/libwegert.so" "$output/wegert-ick-armeabi-v7a.apk" > "$output/artifact.sha256"
printf 'full_application_compile\tPASS\nndk_platform_link\tPASS\nreference_export_comparison\tPASS\napk_packaging\tPASS\nstable_test_signer\tPASS\n' >> "$output/receipt.tsv"
printf '\033[32mPASS\033[0m complete ICK ARMv7 library and signed APK: %s\n' "$output/wegert-ick-armeabi-v7a.apk"
