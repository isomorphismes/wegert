Categories:
  - Science & Education
License: GPL-3.0-or-later
AuthorName: isomorphisms
AuthorEmail: isomorphisms@sdf.org
AuthorWebSite: https://x.com/isomorph_nix
SourceCode: https://github.com/isomorphismes/wegert
IssueTracker: https://github.com/isomorphismes/wegert/issues

Name: zero & infinity

RepoType: git
Repo: https://github.com/isomorphismes/wegert.git

Builds:
  - versionName: @VERSION_NAME@
    versionCode: @VERSION_CODE@
    commit: @SOURCE_REVISION@
    subdir: _/build
    output: build/fdroid/wegert-release-unsigned.apk
    rm:
      - _/build/app/build.gradle.kts
      - _/build/app/wegert-debug.keystore
      - _/build/build.gradle.kts
      - _/build/complex_math_ick.o
      - _/build/gradle
      - _/build/settings.gradle.kts
    prebuild:
      - sdkmanager "platforms;android-@TARGET_SDK@" "build-tools;@BUILD_TOOLS@"
      - sdkmanager "cmake;@CMAKE@"
    build: SDK_ROOT="$$SDK$$" NDK_ROOT="$$NDK$$" bash fdroid/build-apk.sh
    ndk: @NDK@

AutoUpdateMode: Version
UpdateCheckMode: Tags ^v[0-9]+\.[0-9]+\.[0-9]+$
UpdateCheckData: _/build/fdroid/release.properties|versionCode=([0-9]+)|.|versionName=([0-9.]+)
CurrentVersion: @VERSION_NAME@
CurrentVersionCode: @VERSION_CODE@
