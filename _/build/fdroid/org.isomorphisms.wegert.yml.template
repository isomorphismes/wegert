Categories:
  - Science & Education
License: GPL-3.0-or-later
SourceCode: https://github.com/isomorphismes/wegert
IssueTracker: https://github.com/isomorphismes/wegert/issues

Name: zero & infinity

RepoType: git
Repo: https://github.com/isomorphismes/wegert.git

Builds:
  - versionName: 0.2.0
    versionCode: 101
    commit: v0.2.0
    subdir: _/build
    sudo:
      - apt-get update
      - apt-get install -y build-essential flex bison texinfo libgmp-dev libmpfr-dev
        libmpc-dev binutils-arm-linux-gnueabi binutils-aarch64-linux-gnu binutils-x86-64-linux-gnu
    output: build/fdroid/wegert-release-unsigned.apk
    srclibs:
      - ICK@fbe86e23d55cfec2000c08e61deea2a407fd7175
      - AICI@f6d825d15cd3c0c34ae1b43240a463ff5d343090
    rm:
      - _/build/app/build.gradle.kts
      - _/build/app/wegert-debug.keystore
      - _/build/build.gradle.kts
      - _/build/complex_math_ick.o
      - _/build/gradle
      - _/build/settings.gradle.kts
    prebuild:
      - sdkmanager "platforms;android-36" "build-tools;36.0.0"
      - sdkmanager "cmake;3.22.1"
      - ln -s "$$AICI$$" ../ai-ci-ick
    build:
      - make -f "$$AICI$$/ick-android/Makefile" all qualify ABI=armeabi-v7a NDK="$$NDK$$"
        ICK_SOURCE="$$ICK$$" ICK_BUILD="$PWD/build/ick-bootstrap/armeabi-v7a" ICK_STAGE="$PWD/ick-stages/armeabi-v7a"
        FORTIFY_SOURCE=2
      - make -f "$$AICI$$/ick-android/Makefile" all qualify ABI=arm64-v8a NDK="$$NDK$$"
        ICK_SOURCE="$$ICK$$" ICK_BUILD="$PWD/build/ick-bootstrap/arm64-v8a" ICK_STAGE="$PWD/ick-stages/arm64-v8a"
        FORTIFY_SOURCE=2
      - make -f "$$AICI$$/ick-android/Makefile" all qualify ABI=x86_64 NDK="$$NDK$$"
        ICK_SOURCE="$$ICK$$" ICK_BUILD="$PWD/build/ick-bootstrap/x86_64" ICK_STAGE="$PWD/ick-stages/x86_64"
        FORTIFY_SOURCE=2
      - SDK_ROOT="$$SDK$$" NDK_ROOT="$$NDK$$" bash fdroid/build-apk.sh
    ndk: 29.0.14206865

AutoUpdateMode: Version
UpdateCheckMode: Tags ^v[0-9]+\.[0-9]+\.[0-9]+$
UpdateCheckData: _/build/fdroid/release.properties|versionCode=([0-9]+)|.|versionName=([0-9.]+)
CurrentVersion: 0.2.0
CurrentVersionCode: 101
