#!/usr/bin/env ysh

shopt --set ysh:upgrade

# Read-only status check for the fdroiddata submission. The merge request lives
# in the public upstream project, so checking it does not require access to the
# submitter's fork. GITLAB_TOKEN is still used when present.
var host = ${GITLAB_HOST:-https://gitlab.com}
var api_base = ${GITLAB_API:-}
if (api_base === '') {
  setvar api_base = "$host/api/v4"
}
var upstream_project = ${GITLAB_UPSTREAM:-fdroid/fdroiddata}
var source_branch = ARGV[0] if len(ARGV) > 0 else ${GITLAB_BRANCH:-master}
var mr_search = ${GITLAB_MR_SEARCH:-zero & infinity}
var token = ${GITLAB_TOKEN:-}

proc gitlab_get(url) {
  if (token !== '') {
    curl --fail-with-body --silent --show-error \
      --header 'Accept: application/json' \
      --header "PRIVATE-TOKEN: $token" \
      $url
  } else {
    curl --fail-with-body --silent --show-error \
      --header 'Accept: application/json' \
      $url
  }
}

proc gitlab_graphql(url) {
  if (token !== '') {
    curl --fail-with-body --silent --show-error \
      --request POST \
      --header 'Content-Type: application/json' \
      --header "PRIVATE-TOKEN: $token" \
      --data-binary '@-' \
      $url
  } else {
    curl --fail-with-body --silent --show-error \
      --request POST \
      --header 'Content-Type: application/json' \
      --data-binary '@-' \
      $url
  }
}

var upstream_encoded = $(printf '%s' $upstream_project | jq -sRr '@uri')
var branch_encoded = $(printf '%s' $source_branch | jq -sRr '@uri')
var search_encoded = $(printf '%s' $mr_search | jq -sRr '@uri')

# Query the target project, not the fork. state=all matters: after acceptance the
# MR is merged, so an open-only check loses the result we care about.
var candidates = $(gitlab_get "$api_base/projects/$upstream_encoded/merge_requests?scope=all&state=all&source_branch=$branch_encoded&search=$search_encoded&order_by=updated_at&sort=desc&per_page=100")
var mr = $(printf '%s\n' $candidates | jq -c 'first')

if (mr === 'null') {
  echo "MR:       none matching '$mr_search' from branch '$source_branch'"
  echo 'Accepted: no'
  echo 'Comments: none'
  exit 0
}

var iid = $(printf '%s\n' $mr | jq -er '.iid')
var full = $(gitlab_get "$api_base/projects/$upstream_encoded/merge_requests/$iid")
var state = $(printf '%s\n' $full | jq -r '.state')
var accepted = 'yes' if state === 'merged' else 'no'
var merge_status = $(printf '%s\n' $full | jq -r '.detailed_merge_status // .merge_status // "unknown"')
var pipeline = $(printf '%s\n' $full | jq -r '.head_pipeline.status // "not reported"')
var labels = $(printf '%s\n' $full | jq -r 'if (.labels | length) == 0 then "none" else (.labels | join(", ")) end')
var merged_at = $(printf '%s\n' $full | jq -r '.merged_at // "-"')
var closed_at = $(printf '%s\n' $full | jq -r '.closed_at // "-"')
var web_url = $(printf '%s\n' $full | jq -r '.web_url')
var source = $(printf '%s\n' $full | jq -r 'if .references.full then .references.full else (.source_branch // "unknown") end')

printf 'MR:       %s\n' $web_url
printf 'State:    %s\n' $state
printf 'Accepted: %s\n' $accepted
printf 'Merge:    %s\n' $merge_status
printf 'Pipeline: %s\n' $pipeline
printf 'Labels:   %s\n' $labels
printf 'Merged:   %s\n' $merged_at
printf 'Closed:   %s\n' $closed_at
printf 'Source:   %s\n' $source

# The REST Notes endpoint requires authentication on GitLab.com even for a
# public MR. GraphQL exposes the same public discussions anonymously, matching
# what an unsigned-in visitor can read on the MR page.
var graphql_query = 'query($project: ID!, $iid: String!) { project(fullPath: $project) { mergeRequest(iid: $iid) { discussions(first: 100) { pageInfo { hasNextPage } nodes { notes(first: 100) { nodes { author { username } body createdAt system } } } } } } }'
var graphql_payload = $(jq -cn --arg query $graphql_query --arg project $upstream_project --arg iid $iid '{query:$query, variables:{project:$project, iid:$iid}}')
var discussions = $(printf '%s' $graphql_payload | gitlab_graphql "$host/api/graphql")
var graphql_errors = $(printf '%s\n' $discussions | jq '[.errors[]?] | length')
if (graphql_errors !== '0') {
  printf '%s\n' $discussions | jq -r '.errors[]?.message' >&2
  exit 1
}

var comment_count = $(printf '%s\n' $discussions | jq '[.data.project.mergeRequest.discussions.nodes[]?.notes.nodes[]? | select(.system == false)] | length')
printf 'Comments: %s\n' $comment_count

if (comment_count === '0') {
  echo '  none'
} else {
  printf '%s\n' $discussions | jq -r '.data.project.mergeRequest.discussions.nodes[]?.notes.nodes[]? | select(.system == false) | "----\n\(.author.username // "unknown") @ \(.createdAt)\n\(.body)"'
}

var more_discussions = $(printf '%s\n' $discussions | jq -r '.data.project.mergeRequest.discussions.pageInfo.hasNextPage // false')
if (more_discussions === 'true') {
  echo 'Comments truncated after first 100 discussion threads.'
}
