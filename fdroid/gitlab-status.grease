#!/usr/bin/env ysh

shopt --set ysh:upgrade

# Read-only status check for the fdroiddata submission. Everything reported here
# is public state; the checker should not need access to the submitter's fork.
var host = ${GITLAB_HOST:-https://gitlab.com}
var api_base = ${GITLAB_API:-}
if (api_base === '') {
  setvar api_base = "$host/api/v4"
}
var upstream_project = ${GITLAB_UPSTREAM:-fdroid/fdroiddata}
var source_branch = ARGV[0] if len(ARGV) > 0 else ${GITLAB_BRANCH:-master}
var mr_search = ${GITLAB_MR_SEARCH:-zero & infinity}
var metadata_file = ${FDROID_METADATA_FILE:-fdroid/org.isomorphisms.wegert.yml.template}

proc gitlab_get(url) {
  curl --fail-with-body --silent --show-error \
    --header 'Accept: application/json' \
    $url
}

proc gitlab_graphql(url) {
  curl --fail-with-body --silent --show-error \
    --request POST \
    --header 'Content-Type: application/json' \
    --data-binary '@-' \
    $url
}

var upstream_encoded = $(printf '%s' $upstream_project | jq -sRr '@uri')
var branch_encoded = $(printf '%s' $source_branch | jq -sRr '@uri')
var search_encoded = $(printf '%s' $mr_search | jq -sRr '@uri')

# Query the target project, not the fork. state=all matters: after acceptance the
# MR is merged, so an open-only check loses the result we care about.
var candidates = $(gitlab_get "$api_base/projects/$upstream_encoded/merge_requests?scope=all&state=all&source_branch=$branch_encoded&search=$search_encoded&order_by=updated_at&sort=desc&per_page=100")
var mr = $(printf '%s\n' $candidates | jq -c 'first')

if (mr === 'null') {
  echo "MR:       none matching '$mr_search' from branch '$source_branch'"
  echo 'Accepted: no'
  echo 'Public comments: none'
  exit 0
}

var iid = $(printf '%s\n' $mr | jq -er '.iid')
var full = $(gitlab_get "$api_base/projects/$upstream_encoded/merge_requests/$iid")
var state = $(printf '%s\n' $full | jq -r '.state')
var accepted = 'yes' if state === 'merged' else 'no'
var merge_status = $(printf '%s\n' $full | jq -r '.detailed_merge_status // .merge_status // "unknown"')
var pipeline = $(printf '%s\n' $full | jq -r '.head_pipeline.status // "not reported"')
var labels = $(printf '%s\n' $full | jq -r 'if (.labels | length) == 0 then "none" else (.labels | join(", ")) end')
var merged_at = $(printf '%s\n' $full | jq -r '.merged_at // "-"')
var closed_at = $(printf '%s\n' $full | jq -r '.closed_at // "-"')
var web_url = $(printf '%s\n' $full | jq -r '.web_url')
var reference = $(printf '%s\n' $full | jq -r 'if .references.full then .references.full else (.source_branch // "unknown") end')

printf 'MR:       %s\n' $web_url
printf 'State:    %s\n' $state
printf 'Accepted: %s\n' $accepted
printf 'Merge:    %s\n' $merge_status
printf 'Pipeline: %s\n' $pipeline
printf 'Labels:   %s\n' $labels
printf 'Merged:   %s\n' $merged_at
printf 'Closed:   %s\n' $closed_at
printf 'Reference: %s\n' $reference

# The reviewer asked whether the app's source repository is public. The MR's
# source_project_id names the submitter's fdroiddata fork, which is a different
# repository. Probe the SourceCode URL from the metadata instead.
if ! test -f $metadata_file {
  echo "F-Droid metadata not found: $metadata_file" >&2
  exit 1
}
var source_url = $(sed -n 's/^SourceCode:[[:space:]]*//p' $metadata_file | head -n 1)
if (source_url === '') {
  echo "SourceCode URL not found in $metadata_file" >&2
  exit 1
}
var source_http = $(curl --silent --show-error --location --output /dev/null --write-out '%{http_code}' $source_url)
printf 'Source repo: %s\n' $source_url
printf 'Source repo HTTP: %s\n' $source_http
if (source_http === '200') {
  echo 'Source public: yes'
} else {
  if (source_http === '404') {
    echo 'Source public: no'
  } else {
    printf 'Unexpected source repository HTTP status: %s\n' $source_http >&2
    exit 1
  }
}

# GitLab's anonymous REST Notes endpoint returns 401, but the public GraphQL MR
# exposes both notes and discussions. Query the notes connection directly: it is
# the complete note feed, whereas the earlier discussions-only query missed a
# later standalone reply/comment.
var graphql_query = 'query($project: ID!, $iid: String!) { project(fullPath: $project) { mergeRequest(iid: $iid) { notes(first: 100, filter: ONLY_COMMENTS) { pageInfo { hasNextPage } nodes { id author { username } body createdAt system } } } } }'
var graphql_payload = $(jq -cn --arg query $graphql_query --arg project $upstream_project --arg iid $iid '{query:$query, variables:{project:$project, iid:$iid}}')
var notes = $(printf '%s' $graphql_payload | gitlab_graphql "$host/api/graphql")
var graphql_errors = $(printf '%s\n' $notes | jq '[.errors[]?] | length')
if (graphql_errors !== '0') {
  printf '%s\n' $notes | jq -r '.errors[]?.message' >&2
  exit 1
}

var comments = $(printf '%s\n' $notes | jq -c '[.data.project.mergeRequest.notes.nodes[]? | select(.system == false)]')
var comment_count = $(printf '%s\n' $comments | jq 'length')
printf 'Public comments: %s\n' $comment_count

if (comment_count === '0') {
  echo '  none'
} else {
  printf '%s\n' $comments | jq -r '.[] | "----\n\(.author.username // "unknown") @ \(.createdAt)\n\(.body)"'
}

var more_notes = $(printf '%s\n' $notes | jq -r '.data.project.mergeRequest.notes.pageInfo.hasNextPage // false')
if (more_notes === 'true') {
  echo 'Public comments truncated after the first 100 notes.'
}
